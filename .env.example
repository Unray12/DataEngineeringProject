# Copy to .env and adjust. `just doctor` validates the important values.
COMPOSE_PROJECT_NAME=agri-platform

# ---------------------------------------------------------------------------
# HDFS (lakehouse storage)
# ---------------------------------------------------------------------------
# NameNode RPC address used by every client (Spark, Trino, Hive Metastore).
HDFS_NAMENODE_URI=hdfs://namenode:8020
# Root paths on HDFS. All three are created by the NameNode bootstrap.
HDFS_WAREHOUSE_PATH=/warehouse
HDFS_CHECKPOINTS_PATH=/checkpoints
HDFS_DBT_PATH=/dbt
# Block replication for this single-DataNode cluster.
HDFS_REPLICATION=1
HADOOP_NAMENODE_HEAP_MB=1024
HADOOP_DATANODE_HEAP_MB=512
# HDFS web UI (NameNode)
HDFS_NAMENODE_HTTP_PORT=9870

# ---------------------------------------------------------------------------
# Kafka (KRaft, single broker)
# ---------------------------------------------------------------------------
KAFKA_INTERNAL_PORT=29092
KAFKA_EXTERNAL_PORT=9092
# Address used by containers (ingest, simulator, Spark)
KAFKA_BOOTSTRAP=kafka:29092
# Address used from the host (tests, debugging)
KAFKA_BOOTSTRAP_HOST=localhost:9092
KAFKA_SENSOR_TOPIC=sensor.readings.v1
KAFKA_TOPIC_PARTITIONS=3
# Quote values containing spaces: dotenv (used by `just`) does not allow bare spaces.
KAFKA_HEAP_OPTS="-Xms512m -Xmx768m"

# ---------------------------------------------------------------------------
# Ingest edge (HTTP push -> Kafka)
# ---------------------------------------------------------------------------
INGEST_PORT=8081
# URL the simulator posts to (container network)
INGEST_URL=http://ingest:8081

# ---------------------------------------------------------------------------
# Hive Metastore (Iceberg catalog) + Trino
# ---------------------------------------------------------------------------
HIVE_METASTORE_PORT=9083
HIVE_METASTORE_URI=thrift://hive-metastore:9083
HIVE_METASTORE_HEAP=1024
ICEBERG_VERSION=1.7.1
TRINO_PORT=8080
TRINO_URI=trino://trino:8080
TRINO_CATALOG=lakehouse
TRINO_SCHEMA=gold
TRINO_USER=agri

# ---------------------------------------------------------------------------
# Cassandra (serving store)
# ---------------------------------------------------------------------------
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=agri
CASSANDRA_CONTACT_POINTS=cassandra:9042
CASSANDRA_WAIT_S=180
CASSANDRA_HEAP=1G
CASSANDRA_NUM_TOKENS=16

# ---------------------------------------------------------------------------
# Spark (streaming + batch + dbt-spark)
# ---------------------------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_DRIVER_CORES=4
SPARK_SHUFFLE_PARTITIONS=4
SPARK_VERSION=3.5.3
# Micro-batch trigger interval. Overridden per benchmark run (10s / 30s / 60s).
TRIGGER_INTERVAL=30s
STARTING_OFFSETS=earliest
MAX_OFFSETS_PER_TRIGGER=20000
# Watermark documents the accepted lateness window; readings older than
# LATE_AFTER_S are kept but flagged is_late (FR3.4).
WATERMARK_S=3600
LATE_AFTER_S=600
# Checkpoint root on HDFS: hdfs://namenode:8020/checkpoints/<checkpoint_root>
CHECKPOINT_ROOT=sensor_pipeline

# ---------------------------------------------------------------------------
# Quality + alert rules (FR4.2, FR8.1, FR8.2, FR8.5)
# ---------------------------------------------------------------------------
# Condition must persist this many micro-batches before an alert opens (debounce).
ALERT_DEBOUNCE_BATCHES=2
# One alert per condition per this window, in seconds.
ALERT_COOLDOWN_S=300
# A device is offline after this many x its nominal reporting interval of silence.
DEVICE_OFFLINE_MULTIPLIER=4
BATTERY_LOW_PCT=20
SIGNAL_POOR_MAX=0.3

# ---------------------------------------------------------------------------
# Master data
# ---------------------------------------------------------------------------
# Path to the shared reference data inside the containers.
REFERENCE_DATA_PATH=/app/reference/reference_data.json

# ---------------------------------------------------------------------------
# Simulator (LoRaWAN-style readings through the ingest edge)
# ---------------------------------------------------------------------------
# http = through the ingest service (normal); kafka = straight to the broker.
SIM_TRANSPORT=http
SIM_RATE_HZ=1
SIM_DURATION_SECONDS=0
SIM_SEED=42
# Fault injection (FR4.1/BR4): null_value,out_of_range,implausible_jump,duplicate,
# unknown_device,unexpected_metric,malformed
SIM_FAULT_RATE=0.05
SIM_FAULTS=null_value,out_of_range,implausible_jump,duplicate,unknown_device,unexpected_metric,malformed
# Device outages (FR8.2): probability per tick and the silence duration in seconds.
SIM_GAP_RATE=0.002
SIM_GAP_SECONDS_MIN=45
SIM_GAP_SECONDS_MAX=90
SIM_FIXTURE=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=8000
