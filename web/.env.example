# Use mock for local placeholders or api for the FastAPI-backed app.
DATA_MODE=mock
# Required when DATA_MODE=api. Use a publicly reachable HTTPS URL for Vercel.
API_BASE_URL=
# Optional server-only header value for FastAPI.
API_KEY=
# Optional shared password gate.
APP_PASSWORD=
# Browser-visible application name.
NEXT_PUBLIC_APP_NAME=AgriMonitor
# Browser-visible display timezone.
NEXT_PUBLIC_TIMEZONE=Asia/Ho_Chi_Minh
